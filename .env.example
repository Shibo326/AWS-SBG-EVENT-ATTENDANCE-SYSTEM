# Copy this file to .env and fill in real values. .env is gitignored and must
# NEVER be committed (PROJECT_PLAN §10 / Brief §3). All keys are VITE_-prefixed
# so Vite exposes them to the client bundle — that is expected here: Firebase
# web config and the EmailJS public key are public-by-design, and access
# control lives in Firebase Security Rules + the data model, not in secrecy of
# these values (§9). Restrict the EmailJS public key by domain in the EmailJS
# dashboard, and lock Firebase with the rules in database.rules.json.

# ── Firebase Realtime Database (web app config) ──────────────────────────────
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# ── EmailJS (client-side QR ticket delivery on approval) ─────────────────────
# The public key is domain-restricted in the EmailJS dashboard (§9.4).
VITE_EMAILJS_SERVICE_ID=your-emailjs-service-id
VITE_EMAILJS_TEMPLATE_ID=your-emailjs-template-id
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key
